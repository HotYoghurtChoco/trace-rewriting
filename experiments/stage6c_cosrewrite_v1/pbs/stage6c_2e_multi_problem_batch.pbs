#!/bin/bash
#PBS -N tr-s6c-batch-2e
#PBS -l select=1:ncpus=8:ngpus=1:mem=128gb:gpu_model=H200
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o /srv/scratch/z5463756/honour/logs/stage6c/tr-s6c-batch-2e-v1.pbs.log

set -euo pipefail
umask 077

METHOD="stage6c_2e_five_problem_batch_preflight_v1_h200_native"
REPO_ROOT="/home/z5463756/honour/papers/trace-rewriting-stage6c"
DRIVER_REL="experiments/stage6c_cosrewrite_v1/run_multi_problem_batch.py"
SINGLE_DRIVER_REL="experiments/stage6c_cosrewrite_v1/run_single_problem_closed_loop.py"
LOCK_REL="experiments/stage6c_cosrewrite_v1/config/stage6c_2e_batch_preflight_lock.json"
PBS_REL="experiments/stage6c_cosrewrite_v1/pbs/stage6c_2e_multi_problem_batch.pbs"
EXPECTED_SINGLE_DRIVER_SHA256="345bf8977eb0f5be76b0690167c5d5cb9177a958381ce06584c2a9777b4d2aa0"
EXPECTED_LOCK_SHA256="5f5a0dd4f46f71e002140d722d1896ac4d130d5e9cd3faa238437dd36e8bef35"
ENV_ROOT="/srv/scratch/z5463756/honour/envs/trace-rewriting-official"
HONOUR_ROOT="/srv/scratch/z5463756/honour"
RESULT_ROOT="$HONOUR_ROOT/results/stage6c-cosrewrite-qwen3-1.7b-v1/backend_preflight"
LOG_ROOT="$HONOUR_ROOT/logs/stage6c"
SIF="$HONOUR_ROOT/containers/vllm-openai-v0.11.0-x86_64.sif"
EXPECTED_SIF_SHA256="e10fa3b1e526c5f375e2221d0afd1461963f729e0a7867c0d88bee10eb065ec3"
SNAPSHOT="$HONOUR_ROOT/cache/huggingface/hub/models--openai--gpt-oss-120b/snapshots/b5c939de8f754692c1647ca79fbf85e8c1e70f8a"
MODEL_ID="openai/gpt-oss-120b"
PORT=18080
SNAPSHOT_RESULT="$RESULT_ROOT/gptoss_snapshot_download_8990062"
CONTAINER_RESULT="$RESULT_ROOT/vllm_container_acquire_8994052"
API_PREFLIGHT_RESULT="$RESULT_ROOT/gptoss_h200_container_api_8995484"
STAGE6C_2D_RESULT="$RESULT_ROOT/gptoss_qwen_single_problem_loop_v6_9033138"
RESUME_FROM="${RESUME_FROM:-}"

: "${PBS_JOBID:?PBS_JOBID is required}"
: "${EXPECTED_EXECUTION_COMMIT:?Pass EXPECTED_EXECUTION_COMMIT with qsub -v}"

JOB_NUMBER="${PBS_JOBID%%.*}"
OUT_DIR="$RESULT_ROOT/gptoss_qwen_five_problem_batch_2e_v1_${JOB_NUMBER}"
SERVER_LOG="$OUT_DIR/vllm_server.log"
SERVER_PID=""
SUCCESS=0

mkdir -p "$LOG_ROOT"
if [[ -e "$OUT_DIR" ]]; then
    echo "STOP: output directory already exists: $OUT_DIR" >&2
    exit 1
fi
mkdir -p "$OUT_DIR/provenance"
exec > >(tee "$OUT_DIR/run.log") 2>&1

write_failed_marker() {
    local exit_code="$1"
    if [[ "$SUCCESS" -ne 1 && ! -e "$OUT_DIR/FAILED" ]]; then
        {
            echo "status=FAIL"
            echo "method=$METHOD"
            echo "job_id=$PBS_JOBID"
            echo "commit=$EXPECTED_EXECUTION_COMMIT"
            echo "exit_code=$exit_code"
            echo "complete_present=$([[ -e "$OUT_DIR/COMPLETE" ]] && echo true || echo false)"
        } > "$OUT_DIR/FAILED.partial"
        mv "$OUT_DIR/FAILED.partial" "$OUT_DIR/FAILED"
    fi
}

stop_server() {
    if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
        kill -TERM -- "-$SERVER_PID" 2>/dev/null || kill -TERM "$SERVER_PID" 2>/dev/null || true
        for _ in $(seq 1 30); do
            if ! kill -0 "$SERVER_PID" 2>/dev/null; then
                break
            fi
            sleep 2
        done
        if kill -0 "$SERVER_PID" 2>/dev/null; then
            kill -KILL -- "-$SERVER_PID" 2>/dev/null || kill -KILL "$SERVER_PID" 2>/dev/null || true
        fi
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    SERVER_PID=""
}

host_memory_snapshot() {
    local destination="$1"
    {
        date -u +%Y-%m-%dT%H:%M:%SZ
        cat /proc/self/cgroup
        free -b
        ps -eo pid,ppid,rss,vsz,comm,args --sort=-rss | head -n 30 || true
    } > "$destination" 2>&1
}

cleanup() {
    local exit_code="$?"
    trap - EXIT INT TERM
    stop_server
    nvidia-smi \
        --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
        --format=csv,noheader \
        > "$OUT_DIR/gpu_memory_after_server_stop.csv" 2>/dev/null || true
    host_memory_snapshot "$OUT_DIR/host_memory_after_server_stop.txt" || true
    write_failed_marker "$exit_code"
    exit "$exit_code"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cd "$REPO_ROOT"

echo "===== JOB ====="
echo "PBS_JOBID: $PBS_JOBID"
echo "hostname: $(hostname)"
echo "method: $METHOD"
echo "execution_commit: $EXPECTED_EXECUTION_COMMIT"
echo "out_dir: $OUT_DIR"
echo "resume_from: ${RESUME_FROM:-none}"
echo "timestamp_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

test -x "$ENV_ROOT/bin/python"
test -f "$DRIVER_REL"
test -f "$SINGLE_DRIVER_REL"
test -f "$LOCK_REL"
test -f "$PBS_REL"
test -f "$SIF"
test -d "$SNAPSHOT"
if [[ -n "$RESUME_FROM" ]]; then
    test -d "$RESUME_FROM"
    [[ "$RESUME_FROM" == "$RESULT_ROOT"/gptoss_qwen_five_problem_batch_2e_v1_* ]]
fi

ACTUAL_HEAD="$(git rev-parse HEAD)"
REMOTE_HEAD="$(git rev-parse origin/research/stage6c-cosrewrite)"
[[ "$ACTUAL_HEAD" == "$EXPECTED_EXECUTION_COMMIT" ]]
[[ "$REMOTE_HEAD" == "$EXPECTED_EXECUTION_COMMIT" ]]
[[ -z "$(git status --porcelain)" ]]
git cat-file -e "$EXPECTED_EXECUTION_COMMIT:$DRIVER_REL"
git cat-file -e "$EXPECTED_EXECUTION_COMMIT:$SINGLE_DRIVER_REL"
git cat-file -e "$EXPECTED_EXECUTION_COMMIT:$LOCK_REL"
git cat-file -e "$EXPECTED_EXECUTION_COMMIT:$PBS_REL"

[[ "$(sha256sum "$SINGLE_DRIVER_REL" | awk '{print $1}')" == "$EXPECTED_SINGLE_DRIVER_SHA256" ]]
[[ "$(sha256sum "$LOCK_REL" | awk '{print $1}')" == "$EXPECTED_LOCK_SHA256" ]]

for dependency in "$SNAPSHOT_RESULT" "$CONTAINER_RESULT" "$API_PREFLIGHT_RESULT"; do
    test -f "$dependency/COMPLETE"
    test ! -e "$dependency/FAILED"
    grep -Fxq "status=PASS" "$dependency/COMPLETE"
done

test -f "$STAGE6C_2D_RESULT/COMPLETE"
test ! -e "$STAGE6C_2D_RESULT/FAILED"
"$ENV_ROOT/bin/python" - \
    "$STAGE6C_2D_RESULT" \
    "$OUT_DIR/provenance/stage6c_2d_v6_dependency.json" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
output = Path(sys.argv[2])
marker = dict(
    line.split("=", 1)
    for line in (root / "COMPLETE").read_text(encoding="utf-8").splitlines()
    if "=" in line
)
result = json.loads(
    (root / "closed_loop_result.json").read_text(encoding="utf-8")
)
expected_commit = "a70c9e65fcd5165a4c0b0e4f10d7e59fc90cd742"
expected_method = "stage6c_2d_single_problem_closed_loop_v6_h200_native"
if marker.get("status") != "PASS":
    raise SystemExit("Stage 6C.2d v6 marker is not PASS")
if marker.get("method") != expected_method:
    raise SystemExit("Unexpected Stage 6C.2d v6 marker method")
if marker.get("commit") != expected_commit:
    raise SystemExit("Unexpected Stage 6C.2d v6 execution commit")
if result.get("status") != "PASS" or not all(result.get("gates", {}).values()):
    raise SystemExit("Stage 6C.2d v6 result did not PASS all gates")
if result.get("execution_commit") != expected_commit:
    raise SystemExit("Stage 6C.2d v6 result commit mismatch")
if result.get("runtime_policy", {}).get("name") != "h200_native_v1":
    raise SystemExit("Stage 6C.2d v6 runtime policy mismatch")
if result.get("trace_repetition_validation", {}).get("regression_status") != "PASS":
    raise SystemExit("Stage 6C.2d v6 repetition regression did not PASS")
if result.get("engineering_final_selection", {}).get("status") != "PASS":
    raise SystemExit("Stage 6C.2d v6 selection did not PASS")
if result.get("selection_only_implemented") is not False:
    raise SystemExit("Stage 6C.2d v6 claim boundary changed")
if result.get("student_trained") is not False or result.get("af_measured") is not False:
    raise SystemExit("Stage 6C.2d v6 unexpectedly claims downstream evidence")
evidence = {
    "status": "PASS",
    "method": expected_method,
    "job_id": marker.get("job_id"),
    "execution_commit": expected_commit,
    "runtime_policy": result["runtime_policy"],
    "trace_repetition_validation": result["trace_repetition_validation"],
    "claim_boundary": result["claim_boundary"],
}
output.write_text(
    json.dumps(evidence, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
print("stage6c_2d_v6_dependency_gate=PASS")
PY

ACTUAL_SIF_SHA256="$(sha256sum "$SIF" | awk '{print $1}')"
[[ "$ACTUAL_SIF_SHA256" == "$EXPECTED_SIF_SHA256" ]]
SNAPSHOT_WEIGHT_COUNT="$(find -L "$SNAPSHOT" -maxdepth 1 -type f -name 'model-*-of-*.safetensors' | wc -l)"
if [[ "$SNAPSHOT_WEIGHT_COUNT" -ne 15 ]]; then
    echo "FAIL: expected 15 dereferenced snapshot weight files, found $SNAPSHOT_WEIGHT_COUNT" >&2
    exit 1
fi
echo "snapshot_weight_count=$SNAPSHOT_WEIGHT_COUNT"
test ! -e "$SNAPSHOT/metal"
test ! -e "$SNAPSHOT/original"

cp "$DRIVER_REL" "$OUT_DIR/provenance/"
cp "$SINGLE_DRIVER_REL" "$OUT_DIR/provenance/"
cp "$LOCK_REL" "$OUT_DIR/provenance/"
cp "$PBS_REL" "$OUT_DIR/provenance/"
git status --short --branch > "$OUT_DIR/provenance/git_status.txt"
git show --format=fuller --no-patch "$EXPECTED_EXECUTION_COMMIT" > "$OUT_DIR/provenance/execution_commit.txt"
sha256sum \
    "$DRIVER_REL" \
    "$SINGLE_DRIVER_REL" \
    "$LOCK_REL" \
    "$PBS_REL" \
    "$SIF" \
    "$SNAPSHOT/model.safetensors.index.json" \
    > "$OUT_DIR/provenance/runtime_sha256.txt"

"$ENV_ROOT/bin/python" - <<'PY' > "$OUT_DIR/provenance/host_runtime.txt"
import platform
import datasets
import math_verify
import peft
import torch
import transformers

print("python={}".format(platform.python_version()))
print("torch={}".format(torch.__version__))
print("torch_compiled_cuda={}".format(torch.version.cuda))
print("transformers={}".format(transformers.__version__))
print("peft={}".format(peft.__version__))
print("datasets={}".format(datasets.__version__))
print("math_verify={}".format(getattr(math_verify, "__version__", "unknown")))
print("cuda_available={}".format(torch.cuda.is_available()))
print("bf16_supported={}".format(torch.cuda.is_bf16_supported()))
if torch.cuda.is_available():
    print("device_name={}".format(torch.cuda.get_device_name(0)))
PY

grep -Fxq "cuda_available=True" "$OUT_DIR/provenance/host_runtime.txt"
grep -Fxq "bf16_supported=True" "$OUT_DIR/provenance/host_runtime.txt"
grep -Fq "device_name=NVIDIA H200" "$OUT_DIR/provenance/host_runtime.txt"

nvidia-smi \
    --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
    --format=csv,noheader \
    > "$OUT_DIR/gpu_memory_before_server.csv"
host_memory_snapshot "$OUT_DIR/host_memory_before_server.txt"

export CUDA_VISIBLE_DEVICES=0
export HF_HOME="$HONOUR_ROOT/cache/huggingface"
export HF_HUB_CACHE="$HONOUR_ROOT/cache/huggingface/hub"
export HF_DATASETS_CACHE="$HONOUR_ROOT/cache/huggingface/datasets"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
export PYTHONNOUSERSITE=1
export PYTHONHASHSEED=888
export OMP_NUM_THREADS=8
export XDG_CACHE_HOME="$HONOUR_ROOT/cache/vllm"
export TRITON_CACHE_DIR="$HONOUR_ROOT/cache/triton/stage6c"
mkdir -p "$XDG_CACHE_HOME" "$TRITON_CACHE_DIR"
ulimit -n 65535 2>/dev/null || true

CONTAINER_EXEC=(
    /bin/apptainer exec
    --nv
    --cleanenv
    --bind "$HONOUR_ROOT:$HONOUR_ROOT"
    --env CUDA_VISIBLE_DEVICES=0
    --env HF_HOME="$HF_HOME"
    --env HF_HUB_CACHE="$HF_HUB_CACHE"
    --env HF_DATASETS_CACHE="$HF_DATASETS_CACHE"
    --env HF_HUB_OFFLINE=1
    --env HF_DATASETS_OFFLINE=1
    --env TRANSFORMERS_OFFLINE=1
    --env HF_HUB_DISABLE_TELEMETRY=1
    --env TOKENIZERS_PARALLELISM=false
    --env VLLM_LOGGING_LEVEL=INFO
    --env VLLM_NO_USAGE_STATS=1
    --env DO_NOT_TRACK=1
    --env PYTHONNOUSERSITE=1
    --env XDG_CACHE_HOME="$XDG_CACHE_HOME"
    --env TRITON_CACHE_DIR="$TRITON_CACHE_DIR"
    "$SIF"
)

echo "===== START CONTAINERIZED VLLM ====="
setsid "${CONTAINER_EXEC[@]}" \
    vllm serve "$SNAPSHOT" \
    --served-model-name "$MODEL_ID" \
    --host 127.0.0.1 \
    --port "$PORT" \
    --tensor-parallel-size 1 \
    --gpu-memory-utilization 0.75 \
    --max-model-len 8192 \
    --dtype bfloat16 \
    --quantization mxfp4 \
    --load-format safetensors \
    --model-impl vllm \
    --seed 0 \
    --reasoning-parser openai_gptoss \
    > "$SERVER_LOG" 2>&1 &
SERVER_PID="$!"
echo "$SERVER_PID" > "$OUT_DIR/vllm_server.pid"

SERVER_READY=0
for attempt in $(seq 1 240); do
    if curl --fail --silent --show-error "http://127.0.0.1:${PORT}/health" > /dev/null 2>&1; then
        SERVER_READY=1
        echo "server_ready_after_attempt=$attempt"
        break
    fi
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then
        echo "vLLM server exited before readiness" >&2
        tail -n 200 "$SERVER_LOG" >&2 || true
        exit 1
    fi
    sleep 5
done
[[ "$SERVER_READY" -eq 1 ]]

curl --fail --silent --show-error \
    "http://127.0.0.1:${PORT}/v1/models" \
    > "$OUT_DIR/api_models_before_batch.json"
nvidia-smi \
    --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
    --format=csv,noheader \
    > "$OUT_DIR/gpu_memory_server_ready.csv"
host_memory_snapshot "$OUT_DIR/host_memory_server_ready.txt"

echo "===== RUN FIVE-PROBLEM BATCH ====="
DRIVER_ARGS=(
    --api-base-url "http://127.0.0.1:${PORT}/v1"
    --output-dir "$OUT_DIR"
    --execution-commit "$EXPECTED_EXECUTION_COMMIT"
    --job-id "$PBS_JOBID"
    --temperature 0.6
    --max-tokens 1024
    --reasoning-effort medium
    --max-generation-attempts 2
)
if [[ -n "$RESUME_FROM" ]]; then
    DRIVER_ARGS+=(--resume-from "$RESUME_FROM")
fi
PYTHONPATH="$REPO_ROOT:$REPO_ROOT/src" "$ENV_ROOT/bin/python" "$DRIVER_REL" "${DRIVER_ARGS[@]}"

nvidia-smi \
    --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
    --format=csv,noheader \
    > "$OUT_DIR/gpu_memory_after_driver.csv"
host_memory_snapshot "$OUT_DIR/host_memory_after_driver.txt"

stop_server
nvidia-smi \
    --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
    --format=csv,noheader \
    > "$OUT_DIR/gpu_memory_after_server_stop.csv"
host_memory_snapshot "$OUT_DIR/host_memory_after_server_stop.txt"

"$ENV_ROOT/bin/python" - "$OUT_DIR" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
result = json.loads((root / "batch_result.json").read_text(encoding="utf-8"))
if result.get("status") != "PASS":
    raise SystemExit("batch_result status is not PASS")
if not all(result.get("gates", {}).values()):
    raise SystemExit("one or more batch gates failed")
if result.get("row_indices") != [0, 1, 2, 3, 4]:
    raise SystemExit("unexpected formal-scale preflight row indices")
if result.get("problem_count") != 5 or result.get("passed_problem_count") != 5:
    raise SystemExit("not all five preflight problems passed")
if result.get("checkpoint_audit", {}).get("status") != "PASS":
    raise SystemExit("checkpoint audit did not PASS")
if result.get("reference", {}).get("mean_reference_gradient_recomputations") != 1:
    raise SystemExit("reference gradient was not shared exactly once")
if result.get("reference", {}).get("scorer_runtime_policy") != "h200_native_v1":
    raise SystemExit("unexpected scorer runtime policy")
if result.get("selection_only_implemented") is not False:
    raise SystemExit("unexpected SelectionOnly claim")
if result.get("formal_protocol_locked") is not False:
    raise SystemExit("6C.2e was mislabeled as a formal protocol lock")
if result.get("formal_rewrite_dataset_created") is not False:
    raise SystemExit("unexpected formal rewrite dataset claim")
if result.get("student_trained") is not False or result.get("af_measured") is not False:
    raise SystemExit("unexpected downstream-result claim")
if result.get("scientific_result") is not False:
    raise SystemExit("6C.2e was mislabeled as a scientific result")
for row_index in range(5):
    problem_dir = root / "problems" / f"row_{row_index:04d}"
    if not (problem_dir / "PROBLEM_COMPLETE").is_file():
        raise SystemExit(f"row {row_index} has no PROBLEM_COMPLETE marker")
    if (problem_dir / "PROBLEM_FAILED").exists():
        raise SystemExit(f"row {row_index} unexpectedly has PROBLEM_FAILED")
print("multi_problem_batch_artifact_gate=PASS")
PY

{
    echo "status=PASS"
    echo "method=$METHOD"
    echo "job_id=$PBS_JOBID"
    echo "commit=$EXPECTED_EXECUTION_COMMIT"
    echo "model_id=$MODEL_ID"
    echo "model_revision=b5c939de8f754692c1647ca79fbf85e8c1e70f8a"
    echo "container_sha256=$EXPECTED_SIF_SHA256"
    echo "row_indices=0,1,2,3,4"
    echo "problem_count=5"
    echo "reference_count=100"
    echo "mean_reference_gradient_recomputations=1"
    echo "scorer_runtime_policy=h200_native_v1"
    echo "a100_score_equivalence_required=false"
    echo "trace_repetition_policy=unicode_alphanumeric_window_v1"
    echo "multi_problem_batch=true"
    echo "checkpoint_roundtrip_validated=true"
    echo "resume_capability_implemented=true"
    echo "requested_host_memory_gb=128"
    echo "requested_walltime=00:30:00"
    echo "cosine_improvement_required=false"
    echo "selection_only_implemented=false"
    echo "formal_protocol_locked=false"
    echo "formal_rewrite_dataset_created=false"
    echo "student_trained=false"
    echo "af_measured=false"
    echo "scientific_result=false"
} > "$OUT_DIR/COMPLETE.partial"
mv "$OUT_DIR/COMPLETE.partial" "$OUT_DIR/COMPLETE"
SUCCESS=1

echo "PASS: Stage 6C.2e five-problem H200 batch preflight completed"
echo "out_dir: $OUT_DIR"
