#!/bin/bash
#PBS -N tr-s6c-ossapi-v1
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb:gpu_model=H200
#PBS -l walltime=00:45:00
#PBS -j oe
#PBS -o /srv/scratch/z5463756/honour/logs/stage6c/tr-s6c-ossapi-v1.pbs.log

set -euo pipefail

WORKTREE="/home/z5463756/honour/papers/trace-rewriting-stage6c"
SCRATCH="/srv/scratch/z5463756/honour"
ENV="$SCRATCH/envs/trace-rewriting-official"
RESULT_ROOT="$SCRATCH/results/stage6c-cosrewrite-qwen3-1.7b-v1"
EXPECTED_EXECUTION_COMMIT="${EXPECTED_EXECUTION_COMMIT:?Pass the committed 6C HEAD with qsub -v}"

LAUNCHER_REL="experiments/stage6c_cosrewrite_v1/pbs/stage6c_2c_gptoss_h200_api_preflight.pbs"
MODEL_ID="openai/gpt-oss-120b"
MODEL_REVISION="b5c939de8f754692c1647ca79fbf85e8c1e70f8a"
SNAPSHOT_PATH="$SCRATCH/cache/huggingface/hub/models--openai--gpt-oss-120b/snapshots/$MODEL_REVISION"
SNAPSHOT_JOB_ID="8990062.kman.restech.unsw.edu.au"
SNAPSHOT_COMMIT="ddebaeea7418ed4b5957706657197314971bbe8c"
SERVED_MODEL_NAME="openai/gpt-oss-120b"

HOST="127.0.0.1"
PORT="18080"
MAX_MODEL_LEN="8192"
GPU_MEMORY_UTILIZATION="0.75"
DTYPE="bfloat16"
QUANTIZATION="mxfp4"
SEED="0"
REASONING_PARSER="openai_gptoss"
STARTUP_TIMEOUT_SECONDS="1800"

JOB_ID_LABEL="${PBS_JOBID%%.*}"
OUT_DIR="$RESULT_ROOT/backend_preflight/gptoss_h200_api_$JOB_ID_LABEL"
SERVER_LOG="$OUT_DIR/vllm_server.log"
SERVER_COMMAND_FILE="$OUT_DIR/vllm_server_command.txt"
STATE_FILE="$OUT_DIR/preflight_state.env"

module purge
module load python/3.11.3
cd "$WORKTREE"

if [[ "$(git branch --show-current)" != "research/stage6c-cosrewrite" ]]; then
    echo "FAIL: unexpected Stage 6C branch"
    exit 1
fi
if [[ "$(git rev-parse HEAD)" != "$EXPECTED_EXECUTION_COMMIT" ]]; then
    echo "FAIL: execution commit mismatch"
    exit 1
fi
if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "FAIL: tracked or staged changes exist"
    git status --short
    exit 1
fi
git cat-file -e "HEAD:$LAUNCHER_REL"

if [[ -e "$OUT_DIR" ]]; then
    echo "FAIL: output directory already exists: $OUT_DIR"
    exit 1
fi
mkdir -p "$OUT_DIR/provenance"

git rev-parse HEAD > "$OUT_DIR/provenance/git_commit.txt"
git status --short --branch > "$OUT_DIR/provenance/git_status.txt"
git show "HEAD:$LAUNCHER_REL" > "$OUT_DIR/provenance/launcher.pbs"
printf 'model_loaded=false\nhealth_tested=false\nmodel_list_tested=false\napi_tested=false\nparser_real_output_tested=false\n' \
    > "$STATE_FILE"

export HF_HOME="$SCRATCH/cache/huggingface"
export HF_HUB_CACHE="$HF_HOME/hub"
export HF_DATASETS_CACHE="$HF_HOME/datasets"
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false
export VLLM_LOGGING_LEVEL=INFO
export VLLM_NO_USAGE_STATS=1
export DO_NOT_TRACK=1

set +e
(
    set -euo pipefail

    server_pid=""

    cleanup_server() {
        if [[ -z "$server_pid" ]] || ! kill -0 "$server_pid" 2>/dev/null; then
            return
        fi

        echo "Stopping vLLM server pid=$server_pid"
        kill -TERM "$server_pid" 2>/dev/null || true

        for _ in $(seq 1 30); do
            process_state="$(ps -o stat= -p "$server_pid" 2>/dev/null || true)"
            if [[ -z "$process_state" || "$process_state" == Z* ]]; then
                wait "$server_pid" 2>/dev/null || true
                return
            fi
            sleep 1
        done

        echo "vLLM server did not stop after 30 seconds; sending KILL"
        kill -KILL "$server_pid" 2>/dev/null || true
        wait "$server_pid" 2>/dev/null || true
    }

    trap cleanup_server EXIT INT TERM

    echo "===== JOB ====="
    echo "PBS_JOBID: $PBS_JOBID"
    echo "hostname: $(hostname)"
    echo "execution_commit: $EXPECTED_EXECUTION_COMMIT"
    echo "out_dir: $OUT_DIR"
    echo "model_id: $MODEL_ID"
    echo "model_revision: $MODEL_REVISION"
    echo "snapshot_path: $SNAPSHOT_PATH"
    echo "snapshot_job_id: $SNAPSHOT_JOB_ID"
    echo "snapshot_commit: $SNAPSHOT_COMMIT"
    echo "served_model_name: $SERVED_MODEL_NAME"
    echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-UNSET}"
    echo "timestamp_utc: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo

    echo "===== SNAPSHOT VALIDATION ====="
    "$ENV/bin/python" - "$SNAPSHOT_PATH" "$MODEL_REVISION" "$OUT_DIR/snapshot_validation.json" <<'PY'
import json
import pathlib
import sys

snapshot = pathlib.Path(sys.argv[1])
expected_revision = sys.argv[2]
output_path = pathlib.Path(sys.argv[3])

if not snapshot.is_dir():
    raise RuntimeError(f"Snapshot directory is absent: {snapshot}")
if snapshot.name != expected_revision:
    raise RuntimeError(
        f"Snapshot revision mismatch: expected {expected_revision}, found {snapshot.name}"
    )
for excluded in ("metal", "original"):
    if (snapshot / excluded).exists():
        raise RuntimeError(f"Excluded alternative weight directory is present: {excluded}")

config_path = snapshot / "config.json"
index_path = snapshot / "model.safetensors.index.json"
if not config_path.is_file():
    raise RuntimeError("config.json is absent")
if not index_path.is_file():
    raise RuntimeError("model.safetensors.index.json is absent")

config = json.loads(config_path.read_text())
index = json.loads(index_path.read_text())

architectures = config.get("architectures", [])
if "GptOssForCausalLM" not in architectures:
    raise RuntimeError(f"Unexpected architectures: {architectures}")
if config.get("model_type") != "gpt_oss":
    raise RuntimeError(f"Unexpected model_type: {config.get('model_type')!r}")

quantization_config = config.get("quantization_config") or {}
quant_method = quantization_config.get("quant_method")
if quant_method != "mxfp4":
    raise RuntimeError(f"Expected mxfp4 quantization, found {quant_method!r}")

weight_files = sorted(set(index.get("weight_map", {}).values()))
if len(weight_files) != 15:
    raise RuntimeError(f"Expected 15 indexed weight files, found {len(weight_files)}")

missing = [name for name in weight_files if not (snapshot / name).is_file()]
if missing:
    raise RuntimeError(f"Indexed weight files are absent: {missing}")
if any("/" in name for name in weight_files):
    raise RuntimeError("Expected only top-level default safetensor weights")

summary = {
    "architectures": architectures,
    "model_type": config.get("model_type"),
    "quantization_method": quant_method,
    "revision": expected_revision,
    "snapshot_path": str(snapshot),
    "weight_file_count": len(weight_files),
}
output_path.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")

for key, value in summary.items():
    print(f"{key}={value}")
print("snapshot_validation=PASS")
PY
    echo

    echo "===== RUNTIME ====="
    "$ENV/bin/python" - <<'PY'
import importlib.metadata
import platform
import sys

import torch

print(f"python_executable={sys.executable}")
print(f"python_version={platform.python_version()}")
for package in ("torch", "vllm", "transformers", "openai"):
    print(f"{package}_version={importlib.metadata.version(package)}")
print(f"torch_compiled_cuda={torch.version.cuda}")
print(f"cuda_available={torch.cuda.is_available()}")

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is not available")
if torch.cuda.device_count() != 1:
    raise RuntimeError(f"Expected one visible GPU, found {torch.cuda.device_count()}")

properties = torch.cuda.get_device_properties(0)
total_memory_gib = properties.total_memory / (1024 ** 3)
print(f"device_name={properties.name}")
print(f"device_total_memory_GiB={total_memory_gib:.3f}")
print(f"device_compute_capability={properties.major}.{properties.minor}")

if "H200" not in properties.name.upper():
    raise RuntimeError(f"Expected an H200, found {properties.name}")
if total_memory_gib < 100:
    raise RuntimeError(f"Expected at least 100 GiB VRAM, found {total_memory_gib:.3f}")
PY

    nvidia-smi > "$OUT_DIR/nvidia_smi_before_server.txt"
    nvidia-smi \
        --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
        --format=csv,noheader \
        > "$OUT_DIR/gpu_memory_before_server.csv"
    echo

    echo "===== PORT CHECK ====="
    "$ENV/bin/python" - "$HOST" "$PORT" <<'PY'
import socket
import sys

host = sys.argv[1]
port = int(sys.argv[2])
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
    try:
        sock.bind((host, port))
    except OSError as exc:
        raise RuntimeError(f"Port {host}:{port} is unavailable: {exc}") from exc
print(f"port_available={host}:{port}")
PY
    echo

    echo "===== START VLLM ====="
    server_command=(
        "$ENV/bin/vllm" serve "$SNAPSHOT_PATH"
        --served-model-name "$SERVED_MODEL_NAME"
        --host "$HOST"
        --port "$PORT"
        --tensor-parallel-size 1
        --gpu-memory-utilization "$GPU_MEMORY_UTILIZATION"
        --max-model-len "$MAX_MODEL_LEN"
        --dtype "$DTYPE"
        --quantization "$QUANTIZATION"
        --load-format safetensors
        --model-impl vllm
        --seed "$SEED"
        --reasoning-parser "$REASONING_PARSER"
    )

    printf '%q ' "${server_command[@]}" > "$SERVER_COMMAND_FILE"
    printf '\n' >> "$SERVER_COMMAND_FILE"
    cat "$SERVER_COMMAND_FILE"

    "${server_command[@]}" > "$SERVER_LOG" 2>&1 &
    server_pid=$!
    echo "$server_pid" > "$OUT_DIR/vllm_server.pid"
    echo "server_pid=$server_pid"
    echo

    echo "===== WAIT FOR HEALTH ====="
    deadline=$((SECONDS + STARTUP_TIMEOUT_SECONDS))
    health_ready=false
    while (( SECONDS < deadline )); do
        if ! kill -0 "$server_pid" 2>/dev/null; then
            echo "FAIL: vLLM server exited before becoming healthy"
            tail -n 160 "$SERVER_LOG" || true
            exit 1
        fi

        if "$ENV/bin/python" - "$HOST" "$PORT" >/dev/null 2>&1 <<'PY'
import sys
import urllib.request

url = f"http://{sys.argv[1]}:{sys.argv[2]}/health"
with urllib.request.urlopen(url, timeout=5) as response:
    if response.status != 200:
        raise RuntimeError(f"Unexpected health status: {response.status}")
PY
        then
            health_ready=true
            break
        fi

        sleep 5
    done

    if [[ "$health_ready" != true ]]; then
        echo "FAIL: vLLM server did not become healthy within $STARTUP_TIMEOUT_SECONDS seconds"
        tail -n 160 "$SERVER_LOG" || true
        exit 1
    fi
    echo "health=PASS"
    printf 'model_loaded=true\nhealth_tested=true\nmodel_list_tested=false\napi_tested=false\nparser_real_output_tested=false\n' \
        > "$STATE_FILE"
    echo

    nvidia-smi > "$OUT_DIR/nvidia_smi_server_ready.txt"
    nvidia-smi \
        --query-gpu=index,name,uuid,driver_version,memory.total,memory.used,memory.free \
        --format=csv,noheader \
        > "$OUT_DIR/gpu_memory_server_ready.csv"

    echo "===== OPENAI-COMPATIBLE API ====="
    "$ENV/bin/python" - \
        "$HOST" "$PORT" "$SERVED_MODEL_NAME" \
        "$OUT_DIR/models_response.json" \
        "$OUT_DIR/chat_completion_response.json" \
        "$OUT_DIR/api_validation_summary.json" <<'PY'
import json
import pathlib
import re
import sys

from openai import OpenAI

host = sys.argv[1]
port = sys.argv[2]
served_model_name = sys.argv[3]
models_output = pathlib.Path(sys.argv[4])
chat_output = pathlib.Path(sys.argv[5])
summary_output = pathlib.Path(sys.argv[6])

client = OpenAI(
    base_url=f"http://{host}:{port}/v1",
    api_key="EMPTY",
    timeout=300.0,
    max_retries=0,
)

models_response = client.models.list()
models_payload = models_response.model_dump(mode="json")
models_output.write_text(json.dumps(models_payload, indent=2, sort_keys=True) + "\n")
model_ids = [item.get("id") for item in models_payload.get("data", [])]
if served_model_name not in model_ids:
    raise RuntimeError(
        f"Served model {served_model_name!r} absent from /v1/models: {model_ids}"
    )

completion = client.chat.completions.create(
    model=served_model_name,
    messages=[
        {
            "role": "system",
            "content": "Answer the arithmetic question accurately and concisely.",
        },
        {
            "role": "user",
            "content": "What is 12 + 7? Give the final answer as one integer.",
        },
    ],
    reasoning_effort="low",
    temperature=0.0,
    max_tokens=512,
)
completion_payload = completion.model_dump(mode="json")
chat_output.write_text(json.dumps(completion_payload, indent=2, sort_keys=True) + "\n")

choices = completion_payload.get("choices") or []
if len(choices) != 1:
    raise RuntimeError(f"Expected exactly one completion choice, found {len(choices)}")

choice = choices[0]
message = choice.get("message") or {}
content = message.get("content")
reasoning_content = message.get("reasoning_content")
finish_reason = choice.get("finish_reason")

if not isinstance(content, str) or not content.strip():
    raise RuntimeError(f"Final content is empty or invalid: {content!r}")
if not re.search(r"(?<!\d)19(?!\d)", content):
    raise RuntimeError(f"Expected arithmetic answer 19 in final content: {content!r}")
if not isinstance(reasoning_content, str) or not reasoning_content.strip():
    raise RuntimeError(
        "reasoning_content was empty or invalid; the gpt-oss parser was not demonstrated"
    )
if finish_reason != "stop":
    raise RuntimeError(f"Expected finish_reason='stop', found {finish_reason!r}")

control_token_pattern = re.compile(r"<\|[^|]+\|>")
for field_name, value in (
    ("content", content),
    ("reasoning_content", reasoning_content),
):
    if control_token_pattern.search(value):
        raise RuntimeError(f"Unparsed Harmony control token found in {field_name}")

usage = completion_payload.get("usage") or {}
summary = {
    "api_base_url": f"http://{host}:{port}/v1",
    "chat_completions": "PASS",
    "content_nonempty": True,
    "content_preview": content[:300],
    "finish_reason": finish_reason,
    "model_list": "PASS",
    "prompt_tokens": usage.get("prompt_tokens"),
    "reasoning_content_present": True,
    "reasoning_preview": reasoning_content[:300],
    "served_model_name": served_model_name,
    "total_tokens": usage.get("total_tokens"),
}
summary_output.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")

for key, value in summary.items():
    print(f"{key}={value}")
print("api_validation=PASS")
PY
    printf 'model_loaded=true\nhealth_tested=true\nmodel_list_tested=true\napi_tested=true\nparser_real_output_tested=true\n' \
        > "$STATE_FILE"
    echo

    if ! kill -0 "$server_pid" 2>/dev/null; then
        echo "FAIL: vLLM server exited after the API request"
        tail -n 160 "$SERVER_LOG" || true
        exit 1
    fi
    echo "server_alive_after_api=PASS"

    echo
    echo "===== VLLM LOG END ====="
    tail -n 120 "$SERVER_LOG"
    echo

    cleanup_server
    server_pid=""
    trap - EXIT INT TERM

    echo "PASS: GPT-OSS-120B loaded on one H200 and served a parsed Chat Completions response"
) 2>&1 | tee "$OUT_DIR/run.log"
pipeline_status=("${PIPESTATUS[@]}")
set -e

preflight_status="${pipeline_status[0]}"
tee_status="${pipeline_status[1]}"
if (( preflight_status != 0 || tee_status != 0 )); then
    printf 'status=FAIL\nmethod=stage6c_2c_gptoss_h200_api_preflight_v1\njob_id=%s\ncommit=%s\nmodel_id=%s\nmodel_revision=%s\npreflight_exit_status=%s\ntee_exit_status=%s\n' \
        "$PBS_JOBID" "$EXPECTED_EXECUTION_COMMIT" \
        "$MODEL_ID" "$MODEL_REVISION" \
        "$preflight_status" "$tee_status" \
        > "$OUT_DIR/FAILED"
    cat "$STATE_FILE" >> "$OUT_DIR/FAILED"
    echo
    echo "FAIL: Stage 6C.2c GPT-OSS-120B H200 API preflight failed"
    echo "out_dir: $OUT_DIR"
    exit 1
fi

printf 'status=PASS\nmethod=stage6c_2c_gptoss_h200_api_preflight_v1\njob_id=%s\ncommit=%s\nmodel_id=%s\nmodel_revision=%s\nsnapshot_job_id=%s\nsnapshot_commit=%s\nserved_model_name=%s\nquantization=%s\ndtype=%s\nmax_model_len=%s\ngpu_memory_utilization=%s\nreasoning_parser=%s\nmodel_loaded=true\nhealth_tested=true\nmodel_list_tested=true\napi_tested=true\nparser_real_output_tested=true\n' \
    "$PBS_JOBID" "$EXPECTED_EXECUTION_COMMIT" \
    "$MODEL_ID" "$MODEL_REVISION" \
    "$SNAPSHOT_JOB_ID" "$SNAPSHOT_COMMIT" \
    "$SERVED_MODEL_NAME" "$QUANTIZATION" "$DTYPE" \
    "$MAX_MODEL_LEN" "$GPU_MEMORY_UTILIZATION" "$REASONING_PARSER" \
    > "$OUT_DIR/COMPLETE"

echo
echo "PASS: Stage 6C.2c GPT-OSS-120B H200 API preflight completed"
echo "out_dir: $OUT_DIR"
