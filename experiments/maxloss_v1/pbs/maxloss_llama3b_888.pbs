#!/bin/bash
#PBS -N tr-ml-llama3b
#PBS -l select=1:ncpus=8:ngpus=1:mem=46gb:gpu_model=H200
#PBS -l walltime=00:30:00
#PBS -j oe

set -euo pipefail
: "${LLAMA_MODEL_DIR:?Pass the local Llama-3.2-3B base directory with qsub -v}"
: "${LLAMA_TOKENIZER_DIR:?Pass the local Llama-3.2-3B-Instruct tokenizer directory with qsub -v}"

REPO_ROOT="/home/z5463756/honour/papers/trace-rewriting-maxloss"
HONOUR_ROOT="/srv/scratch/z5463756/honour"
ENV_ROOT="$HONOUR_ROOT/envs/trace-rewriting-official"
GENERATION_DIR="$HONOUR_ROOT/results/maxloss-qwen3-1.7b-v1/formal_9679942"
RESULT_ROOT="$HONOUR_ROOT/results/maxloss-llama3.2-3b-v1"
STUDENT_SEED=888
STUDENT_DIR="$RESULT_ROOT/students_seed_${STUDENT_SEED}_${PBS_JOBID%%.*}"

module purge
module load gcc/12.2.0 python/3.11.3 cuda/12.8.0
cd "$REPO_ROOT"
export PATH="$ENV_ROOT/bin:$PATH"
export PYTHONPATH="$REPO_ROOT:$REPO_ROOT/src"
export HF_HOME="$HONOUR_ROOT/cache/huggingface"
export XDG_CACHE_HOME="$HONOUR_ROOT/cache"
export HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
export PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8 TRACE_NUM_PROC=4 WANDB_DISABLED=true
export VLLM_WORKER_MULTIPROC_METHOD=spawn
export TMPDIR="${TMPDIR:-/tmp}/maxloss_llama_${PBS_JOBID%%.*}"
export TRITON_CACHE_DIR="$TMPDIR/triton"
mkdir -p "$TRITON_CACHE_DIR"

echo "execution_commit=$(git rev-parse HEAD)"
echo "generation_dir=$GENERATION_DIR"
echo "student_model=$LLAMA_MODEL_DIR"
echo "student_tokenizer=$LLAMA_TOKENIZER_DIR"
echo "student_results=$STUDENT_DIR"

"$ENV_ROOT/bin/python" -u experiments/maxloss_v1/prepare_students.py \
    --generation-dir "$GENERATION_DIR" --working-dir "$STUDENT_DIR" --seed "$STUDENT_SEED" \
    --student-model "$LLAMA_MODEL_DIR" --student-tokenizer "$LLAMA_TOKENIZER_DIR"

"$ENV_ROOT/bin/python" -u -m experiments.maxloss_v1.train_transfer_students \
    --config "$STUDENT_DIR/config.yaml" --seed "$STUDENT_SEED"

cat "$STUDENT_DIR/iter_0/instructions_and_scores.yaml"
